              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>.65 .15 .8 1</diffuse>
          </material>
        </visual>
        <sensor name="crossing_obstacle_2_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact>
            <collision>obstacle_collision</collision>
          </contact>
          <plugin name="crossing_obstacle_2_bumper" filename="libgazebo_ros_bumper.so">
            <ros>
              <remapping>bumper_states:=/obstacle_contacts</remapping>
            </ros>
            <frame_name>world</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30</update_rate>
    </plugin>
    <gui fullscreen="0">
      <camera name="overview">
        <pose>0 -32 35 0 .83 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>