<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="narrow_dynamic">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>.8 .8 .8 1</diffuse>
      <direction>-.5 .2 -1</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 30</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="north">
      <static>true</static>
      <pose>0 3.1 0.6 0 0 0</pose>
      <link name="body">
        <collision name="north_collision">
          <geometry>
            <box>
              <size>12.4 0.2 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="north_visual">
          <geometry>
            <box>
              <size>12.4 0.2 1.2</size>
            </box>
          </geometry>
          <material>
            <diffuse>.55 .6 .65 1</diffuse>
          </material>
        </visual>
        <sensor name="north_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact>
            <collision>north_collision</collision>
          </contact>
          <plugin name="north_bumper" filename="libgazebo_ros_bumper.so">
            <ros>
              <remapping>bumper_states:=/static_contacts</remapping>
            </ros>
            <frame_name>world</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
    <model name="south">
