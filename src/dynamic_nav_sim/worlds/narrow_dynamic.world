    <model name="crossing_obstacle">
      <pose>0.0 1.6 .5 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>1</ixx>
            <iyy>1</iyy>
            <izz>1</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="obstacle_collision">
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="obstacle_visual">
          <geometry>
