<?xml version='1.0' encoding='utf-8'?>
<robot name="generic_demo_robot">
  <link name="base_footprint" />
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 .16" />
      <mass value="8.0" />
      <inertia ixx="0.13866666666666666" iyy="0.24960000000000002" izz="0.36906666666666665" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual name="base_link_visual">
      <origin xyz="0 0 .16" rpy="0 0 0" />
      <geometry>
        <box size=".60 .44 .12" />
      </geometry>
      <material name="base_link_color">
        <color rgba=".12 .45 .8 1" />
      </material>
    </visual>
    <collision name="base_link_collision">
      <origin xyz="0 0 .16" rpy="0 0 0" />
      <geometry>
        <box size=".60 .44 .12" />
      </geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0" />
  </joint>
  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.00052" iyy="0.00096" izz="0.00052" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual name="left_wheel_visual">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".08" length=".04" />
      </geometry>
      <material name="left_wheel_color">
        <color rgba=".08 .09 .12 1" />
      </material>
    </visual>
    <collision name="left_wheel_collision">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".08" length=".04" />
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="0 0.24 .08" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="20" />
    <dynamics damping=".01" friction="0" />
  </joint>
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>
  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.00052" iyy="0.00096" izz="0.00052" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual name="right_wheel_visual">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".08" length=".04" />
      </geometry>
      <material name="right_wheel_color">
        <color rgba=".08 .09 .12 1" />
      </material>
    </visual>
    <collision name="right_wheel_collision">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".08" length=".04" />
      </geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0 -0.24 .08" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="20" />
    <dynamics damping=".01" friction="0" />
  </joint>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>
  <link name="front_support">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="6.400000000000001e-05" iyy="6.400000000000001e-05" izz="6.400000000000001e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual name="front_support_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius=".04" />
      </geometry>
      <material name="front_support_color">
        <color rgba=".2 .2 .2 1" />
      </material>
    </visual>
    <collision name="front_support_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius=".04" />
      </geometry>
    </collision>
  </link>
  <joint name="front_support_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_support" />
    <origin xyz="0.23 0 .04" />
  </joint>
  <gazebo reference="front_support">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <link name="rear_support">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="6.400000000000001e-05" iyy="6.400000000000001e-05" izz="6.400000000000001e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual name="rear_support_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius=".04" />
      </geometry>
      <material name="rear_support_color">
        <color rgba=".2 .2 .2 1" />
      </material>
    </visual>
    <collision name="rear_support_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius=".04" />
      </geometry>
    </collision>
  </link>
  <joint name="rear_support_joint" type="fixed">
    <parent link="base_link" />
    <child link="rear_support" />
    <origin xyz="-0.23 0 .04" />
  </joint>
  <gazebo reference="rear_support">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <link name="laser_link">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="1.2500000000000002e-05" iyy="1.2500000000000002e-05" izz="1.2500000000000002e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual name="laser_link_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius=".025" />
      </geometry>
      <material name="laser_link_color">
        <color rgba=".1 .8 .6 1" />
      </material>
    </visual>
    <collision name="laser_link_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius=".025" />
      </geometry>
    </collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_link" />
    <origin xyz=".20 0 .25" />
  </joint>
  <gazebo reference="laser_link">
    <sensor name="generic_laser" type="ray">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="scan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan_raw</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.48</wheel_separation>
      <wheel_diameter>0.16</wheel_diameter>
      <max_wheel_torque>12</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odometry_source>1</odometry_source>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>