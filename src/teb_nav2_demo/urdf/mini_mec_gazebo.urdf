<?xml version="1.0"?>
<robot name="mini_mec">
  <material name="body_gray">
    <color rgba="0.75 0.90 0.96 1.0"/>
  </material>

  <material name="wheel_dark">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>

  <material name="wheel_light">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.07258" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.06"/>
    </inertial>
    <visual name="base_mesh">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://teb_nav2_demo/meshes/mini_mec_robot_meshes/base_link.STL"/>
      </geometry>
      <material name="body_gray"/>
    </visual>
    <visual name="controller_mesh">
      <origin xyz="-0.055634313 -0.040782114 0.052" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://teb_nav2_demo/meshes/mini_mec_robot_meshes/controller_link.STL"/>
      </geometry>
      <material name="wheel_light"/>
    </visual>
    <collision name="base_collision">
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.266 0.25 0.10"/>
      </geometry>
    </collision>
  </link>

  <link name="lf_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://teb_nav2_demo/meshes/mini_mec_robot_meshes/lf_wheel_link.STL"/>
      </geometry>
      <material name="wheel_light"/>
    </visual>
  </link>

  <joint name="lf_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lf_wheel_link"/>
    <origin xyz="0.078890687 0.099101093 -0.0363" rpy="0 0 0"/>
  </joint>

  <link name="lb_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://teb_nav2_demo/meshes/mini_mec_robot_meshes/lb_wheel_link.STL"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <joint name="lb_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lb_wheel_link"/>
    <origin xyz="-0.093009313 0.099081093 -0.0363" rpy="0 0 0"/>
  </joint>

  <link name="rb_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://teb_nav2_demo/meshes/mini_mec_robot_meshes/rb_wheel_link.STL"/>
      </geometry>
      <material name="wheel_light"/>
    </visual>
  </link>

  <joint name="rb_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rb_wheel_link"/>
    <origin xyz="-0.093009313 -0.098922907 -0.0363" rpy="0 0 0"/>
  </joint>

  <link name="rf_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://teb_nav2_demo/meshes/mini_mec_robot_meshes/rf_wheel_link.STL"/>
      </geometry>
      <material name="wheel_light"/>
    </visual>
  </link>

  <joint name="rf_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rf_wheel_link"/>
    <origin xyz="0.078890687 -0.098902907 -0.0363" rpy="0 0 0"/>
  </joint>

  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://teb_nav2_demo/meshes/mini_mec_robot_meshes/laser.STL"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.031631037 0.000090581 0.095024184" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://teb_nav2_demo/meshes/mini_mec_robot_meshes/camera_link.STL"/>
      </geometry>
      <material name="wheel_light"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.107094687 0.000317093 0.076204" rpy="0 0 0"/>
  </joint>

  <gazebo reference="laser">
    <sensor name="mini_mec_laser" type="ray">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="mini_mec_laserscan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="mini_mec_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <publish_rate>30</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>
</robot>
